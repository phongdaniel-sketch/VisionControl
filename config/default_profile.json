{
  "version": 1,
  "pointer_mode": "gesture",
  "mouse_hand": "Right",
  "keyboard_hand": "Left",
  "swap_hands": true,
  "monitor_mode": "fixed",
  "fixed_monitor": 0,
  "arming": {
    "enabled": false,
    "gesture": "fist",
    "hold_seconds": 1.0,
    "release_frames": 4,
    "cooldown_seconds": 0.5,
    "auto_disarm_on_hand_loss_seconds": 2.0
  },
  "left_hand": {
    "point": {"type": "press", "keys": ["w"]},
    "peace": {"type": "press", "keys": ["a"]},
    "three_fingers": {"type": "press", "keys": ["d"]},
    "four_fingers": {"type": "press", "keys": ["s"]},
    "open_palm": {"type": "press", "keys": ["space"]}
  },
  "thresholds": {
    "gesture_confidence": 0.7,
    "gesture_on_frames": 3,
    "gesture_off_frames": 4,
    "mouse_move_gesture": "any",
    "mouse_primary_click_gesture": "pinch_index",
    "mouse_secondary_click_gesture": "pinch_middle",
    "mouse_scroll_gesture": "peace",
    "pinch_close_ratio": 0.35,
    "pinch_open_ratio": 0.5,
    "cursor_smoothing": 0.6,
    "cursor_adaptive_smoothing": true,
    "pinch_confirm_seconds": 0.1,
    "pinch_release_seconds": 0.1,
    "cursor_deadzone_px": 0.5,
    "drag_hold_seconds": 0.4,
    "scroll_deadzone": 0.015,
    "scroll_sensitivity": 45.0,
    "monitor_edge_switch_enabled": true,
    "monitor_edge_zone": 0.08,
    "monitor_edge_dwell_seconds": 0.8
  }
}
